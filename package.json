{
  "name": "notification-router",
  "version": "1.0.0",
  "private": true,
  "description": "Multimodal WhatsApp message notification router — HackerRank Orchestrate August 2026",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "route": "tsx scripts/route.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "analyze:media": "tsx scripts/analyze-media.ts",
    "db:seed": "tsx scripts/seed-supabase.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run route && npm run evaluate",
    "prebuild": "tsx scripts/prepare-public-media.ts",
    "predev": "tsx scripts/prepare-public-media.ts",
    "explain": "tsx scripts/explain.ts",
    "package": "tsx scripts/package-submission.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
