# ---------------------------------------------------------------------------
# All values are optional. With none of them set, the router runs fully
# offline against dataset/*.csv and produces identical, deterministic output.
# Never commit a real .env file — see .gitignore.
# ---------------------------------------------------------------------------

# --- Supabase (optional data layer) ----------------------------------------
# When both are set, the web app reads reference data and stores routing runs
# in Supabase. When unset, it falls back to the bundled CSV snapshot.
NEXT_PUBLIC_SUPABASE_URL=

# The browser-safe key. Supabase renamed these: older projects issue an `anon`
# JWT, newer ones a `sb_publishable_…` key. Either name works — set whichever
# your project shows under Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required by `npm run db:seed` to write reference data.
# This key bypasses row level security — never expose it to the browser and
# never prefix it with NEXT_PUBLIC_. Newer projects call it `sb_secret_…`;
# SUPABASE_SECRET_KEY is accepted as an alias.
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq Cloud (optional LLM adjudicator) ---------------------------------
# When ROUTER_LLM_ADJUDICATOR=on and GROQ_API_KEY is set, borderline decisions
# (those with a low margin between the top two candidate actions) get a second
# opinion from a Groq-hosted model. The deterministic decision is always
# computed first and is used verbatim if the adjudicator errors, times out, or
# returns anything that fails schema validation.
ROUTER_LLM_ADJUDICATOR=off
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
